# ─────────────────────────────────────────────────────────────────────────
# Отправка писем с форм на экране результатов.
# Скопировать в .env.local и заполнить ОДИН из двух блоков.
# Без них формы работают, но письмо не уходит: пользователю показывается
# запасная ссылка mailto, а само письмо печатается в консоль сервера.
# ─────────────────────────────────────────────────────────────────────────

# ВАРИАНТ 1 — SMTP собственного ящика. Домен не нужен, стоит ноль.
# Для Gmail: включить двухфакторную аутентификацию и создать «пароль
# приложения» (App password), обычный пароль от почты не подойдёт.
# Письма уходят с её реального адреса.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ВАРИАНТ 2 — Resend. Требует подтверждённого домена, зато письма уходят
# с адреса вида hello@вашдомен.com и лучше доходят до незнакомых адресатов.
# Если заполнены оба блока, приоритет у SMTP.
RESEND_API_KEY=
EMAIL_FROM=

# Отправитель. Для SMTP можно не заполнять — возьмётся SMTP_USER.
# Для Resend обязателен и должен быть на подтверждённом домене.
